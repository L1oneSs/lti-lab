{
  "name": "Moodle LTI lab — Node.js 24 + MongoDB",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Moodle LTI trainer",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": {
    "dependencies": "npm ci",
    "environment": "node scripts/setup-codespaces.mjs"
  },
  "postStartCommand": "docker compose up -d mongo",
  "remoteUser": "node"
}
